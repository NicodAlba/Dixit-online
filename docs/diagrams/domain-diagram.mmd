classDiagram
    direction TB
    %% ADMIN is a User authority, not a subclass.
    class User {
        String username
        String password
    }
    class Authorities {
        String authority
    }
    class Game {
        String password
        Date startDate
        Date endDate
        boolean cancelled
    }
    class Player {
        Integer points
    }
    class Turn {
        TurnState state
        String clue
    }
    class Card
    class Image {
        String url
    }
    class Message {
        Date date
        String text
    }
    class FriendRequest {
        Date dateAccepted
    }
    class GameInvitation {
        String inviter
        String password
    }
    class Achievement {
        String description
        Date dateObtained
        Integer threshold
    }
    class BadgeImage {
        String url
        AchievementType type
    }
    class WinAchievement
    class PlayAchievement
    class TrickAchievement
    Achievement <|-- WinAchievement
    Achievement <|-- PlayAchievement
    Achievement <|-- TrickAchievement
    Authorities "1" <-- "0..*" User
    User "1" <-- "0..*" Game : leader
    User "1" <-- "0..*" Player
    Game "0..1" *-- "0..*" Player : seats
    Game "0..*" --> "0..*" Player : winners
    Game "0..*" --> "0..*" User : spectators
    Game "1" *-- "0..*" Turn
    Game "1" *-- "0..*" Card : deck and history
    Game "1" *-- "0..*" Message
    Player "1" <-- "0..*" Message : author
    Player "1" <-- "0..*" Turn : storyteller
    Turn "0..*" --> "0..1" Card : answer
    Turn "0..1" --> "0..*" Card : played cards
    Player "0..1" <-- "0..*" Card : hand owner
    User "0..1" <-- "0..*" Card : recorded author
    Card "0..*" --> "1" Image
    Card "0..*" --> "0..*" Player : historical votes
    Player "0..*" --> "0..1" Card : playerVote
    FriendRequest "0..*" --> "1" User : sender
    FriendRequest "0..*" --> "1" User : receiver
    GameInvitation "0..*" --> "1" User : recipient
    GameInvitation ..> Game : gameId (no FK)
    User "1" --> "0..*" Achievement
    Achievement "0..*" --> "1" BadgeImage
