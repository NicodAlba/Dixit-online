        startDate
        endDate
        password
    }
    class Message {
        datetime
        text
    }
    class Turn {
        number
        hint
    }
    class Player {
        points
    }
    class Card
    class Image {
        url
    }
    class User {
        username
        password
    }
    class GameInvitation {
        inviter
        password
        gameId
    }
    class FriendRequest {
        dateAccepted
    }
    class Admin
