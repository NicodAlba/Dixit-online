flowchart TB
    subgraph Social["Accounts and social"]
        U["User · account"]
        F["FriendRequest"]
        I["GameInvitation"]
        A["Achievement"]
        F -->|sender and recipient| U
        I -->|recipient| U
        U -->|earns| A
    end
    subgraph Play["Lobby and gameplay"]
        G["Game · lobby and result"]
        P["Player · seat, hand and score"]
        T["Turn · clue, answer and phase"]
        M["Message"]
        G -->|seats| P
        G -->|rounds| T
        M -->|sent by| P
        M -->|belongs to| G
    end
    subgraph Deck["Cards and history"]
        C["Card · one occurrence"]
        ART["Image · reusable illustration"]
        C -->|uses| ART
    end
    U -->|participates as| P
    I -.->|stores game ID| G
    G -->|tracks| C
    T -->|records played cards| C
    P -->|casts votes on| C
