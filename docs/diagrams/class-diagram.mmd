    Game "0..1" *-- "1..4" Player : plays
    Player "0..1" --> "0..2" Turn : isStoryteller
    User "1..1" *-- "0..N" Player
    Player "0..1" --> "0..6" Card : owns
    Player "0..N" --> "0..N" Card : votes
    User "1..1" --> "0..N" Card : hasPlayed
    Card "1..1" --> "0..1" Turn : isAnswer
    Card "0..N" -- "1..1" Image
    User "0..N" -- "0..N" GameInvitation
    User --> User : receives
    User --> User : sends
    User .. "0..N" FriendRequest
    User *-- "0..N" Achievement
    Achievement "0..N" -- "1..1" BadgeImage
    User <|-- Admin
    Achievement <|-- WinAchievement
    Achievement <|-- PlayAchievement
    Achievement <|-- TrickAchievement
    %% FriendRequest is the association class of the User sends/receives relationship.
