# Placeholders only. Load actual values through the runtime secret manager.
# Spring does not load this file automatically. Never commit a populated copy.
SPRING_PROFILES_ACTIVE=prod
DIXIT_DB_URL=jdbc:postgresql://<database-host>:5432/<database>
DIXIT_DB_USERNAME=<runtime-connection-user>
DIXIT_DB_ROLE=<runtime-role-identifier>
DIXIT_DB_PASSWORD=<runtime-secret>
DIXIT_MIGRATION_DB_USERNAME=<migration-connection-user>
DIXIT_MIGRATION_DB_PASSWORD=<migration-secret>
DIXIT_JWT_SECRET=<private-base64-of-at-least-64-random-bytes>
DIXIT_DB_SSL_MODE=verify-full
DIXIT_ALLOWED_ORIGINS=https://<approved-public-host>
DIXIT_TRUSTED_PROXY_REGEX=<provider-confirmed-proxy-address-regex>
PORT=8080
